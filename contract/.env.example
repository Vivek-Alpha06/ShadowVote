# Copy to .env and fill in. NEVER commit the real .env (see .gitignore).
# Use a fresh TESTNET-ONLY wallet — never a seed/key that holds real funds.

# Your funded testnet wallet seed (hex, BIP32). This wallet SIGNS the deploy
# transaction and pays the DUST fee. Get testnet DUST from the faucet:
# https://docs.midnight.network
SHADOWVOTE_WALLET_SEED=

# A 32-byte hex secret used as your organizer key inside the contract's private
# state (this is an app-level key you generate — NOT your wallet key). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SHADOWVOTE_ADMIN_SK=

# Optional: password protecting the local encrypted private-state store.
SHADOWVOTE_PRIVATE_STORE_PASSWORD=

# Optional endpoint overrides (defaults target testnet-02 + local proof server).
# MN_NODE=https://rpc.testnet-02.midnight.network
# MN_INDEXER=https://indexer.testnet-02.midnight.network/api/v1/graphql
# MN_INDEXER_WS=wss://indexer.testnet-02.midnight.network/api/v1/graphql/ws
# MN_PROOF_SERVER=http://127.0.0.1:6300
